generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        Role
  createdAt   DateTime @default(now())
  bio         String?
  experience  String?
  skills      String?
  rating      Float    @default(0)
  ratingCount Int      @default(0)

  mentorRating Float @default(0)

  mentorRatingCount Int @default(0)

  mentorshipPoints Int @default(0)

  mentorLevel Int @default(1)

  username                   String           @unique
  lastActivitySeenAt         DateTime         @default(now())
  mentorStatus               MentorStatus?
  country                    String?
  mobileNumber               String?
  countryCode                String?
  phoneE164                  String?          @unique
  availabilityStatus         String?
  passwordResetToken         String?
  passwordResetExpiry        DateTime?
  careerGoal                 String?
  emailNotifications         Boolean          @default(true)
  githubUrl                  String?
  headline                   String?
  inAppNotifications         Boolean          @default(true)
  isPortfolioPublic          Boolean          @default(true)
  linkedinUrl                String?
  notifyBadges               Boolean          @default(true)
  notifyMentorMessages       Boolean          @default(true)
  notifyOrganizationMessages Boolean          @default(true)
  supportMessages            SupportMessage[]

  accountActionReason String?

  accountStatus String    @default("ACTIVE")
  deactivatedAt DateTime?
  deletedAt     DateTime?

  directConversationParticipants DirectConversationParticipant[] @relation("DirectConversationParticipants")
  directMessagesSent             DirectMessage[]                 @relation("DirectMessagesSent")
  directMessageReads             DirectMessageRead[]             @relation("DirectMessageReads")

  notifyProjectUpdates Boolean             @default(true)
  notifyReviews        Boolean             @default(true)
  notifyWeeklySummary  Boolean             @default(false)
  openToMentorGuidance Boolean             @default(true)
  portfolioWebsite     String?
  preferredDifficulty  String?
  showBadgesPublicly   Boolean             @default(true)
  showBioPublicly      Boolean             @default(true)
  showCountryPublicly  Boolean             @default(true)
  showEmailPublicly    Boolean             @default(false)
  showPhonePublicly    Boolean             @default(false)
  showReviewsPublicly  Boolean             @default(true)
  showSkillsPublicly   Boolean             @default(true)
  profileImageUrl      String?
  emailOtp             String?
  emailOtpExpiry       DateTime?
  emailVerified        Boolean             @default(false)
  applications         Application[]       @relation("VolunteerApplications")
  projectSubmissions   ProjectSubmission[]
  badges               Badge[]
  sentMessages         ChatMessage[]
  messageReads         ChatMessageRead[]
  mentorRequests       MentorshipRequest[] @relation("MentorRequests")
  volunteerRequests    MentorshipRequest[] @relation("VolunteerRequests")
  notifications        Notification[]
  portfolio            PortfolioItem[]
  mentoredProjects     Project[]           @relation("MentorProjects")
  projects             Project[]           @relation("OrganizationProjects")
  reviewsGiven         Review[]            @relation("OrganizationReviews")
  reviewsReceived      Review[]            @relation("VolunteerReviews")

  referralCode String?

  referredByCode String?

  referralsMade Referral[] @relation("ReferrerReferrals")
  referredBy    Referral?  @relation("ReferredUser")

  referralCount   Int   @default(0)
  referralBalance Float @default(0)

  submissionComments ProjectSubmissionComment[]

  mentorReviewsReceived MentorReview[] @relation("MentorReviewsReceived")

  mentorReviewsGiven MentorReview[] @relation("MentorReviewsGiven")

  certificates Certificate[]

  level Int @default(1)

  points Int @default(0)

  mentorAvailabilities   MentorAvailability[]
  mentorBookingsReceived MentorBooking[]      @relation("MentorBookingsReceived")
  mentorBookingsMade     MentorBooking[]      @relation("MentorBookingsMade")

  mentorCertifications MentorCertification[]

  opportunities    Opportunity[]     @relation("OrganizationOpportunities")
  opportunityLeads OpportunityLead[] @relation("OpportunityLeads")

  organizationVerified Boolean @default(false)

  organizationVerifiedAt DateTime?

  organizationVerificationStatus String @default("PENDING")

  organizationVerification OrganizationVerification?

  lastPlatformReviewPromptAt DateTime?

  communityPosts    CommunityPost[]
  communityComments CommunityComment[]

  communityReactions CommunityReaction[]

  communityReports CommunityReport[]

  communityMessages CommunityMessage[]

  communityPoints Int @default(0)

  communityPollVotes CommunityPollVote[]

  communityStories CommunityStory[]

  communityStoryViews     CommunityStoryView[]
  communityStoryReactions CommunityStoryReaction[]

  platformReviews PlatformReview[]

  
}

/// *
/// * =======================
/// * PROJECT
/// * =======================
model Project {
  id                 String              @id @default(cuid())
  title              String
  description        String
  requirements       String?
  status             ProjectStatus       @default(OPEN)
  createdAt          DateTime            @default(now())
  organizationId     String
  difficulty         Difficulty
  skills             String[]
  stipendAmount      Int                 @default(0) // stored in kobo
  deliveryDays       Int                 @default(7)
  deliveryStartedAt  DateTime?
  deliveryDueAt      DateTime?
  mentorId           String?
  applications       Application[]
  mentorshipRequests MentorshipRequest[]
  portfolioItems     PortfolioItem[]
  mentor             User?               @relation("MentorProjects", fields: [mentorId], references: [id])
  organization       User                @relation("OrganizationProjects", fields: [organizationId], references: [id])
  chat               ProjectChat?
  reviews            Review[]
  submissions        ProjectSubmission[]

  mentorReviews MentorReview[]

  deadline48hNotifiedAt     DateTime?
  deadline24hNotifiedAt     DateTime?
  deadline12hNotifiedAt     DateTime?
  deadlineOverdueNotifiedAt DateTime?

  referenceNo String? @unique

  supportMessages SupportMessage[]

  mentorBookings MentorBooking[]
}

/// *
/// * =======================
/// * APPLICATION
/// * =======================
model Application {
  id          String            @id @default(cuid())
  status      ApplicationStatus @default(PENDING)
  source      ApplicationSource @default(VOLUNTEER)
  createdAt   DateTime          @default(now())
  volunteerId String
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  volunteer   User              @relation("VolunteerApplications", fields: [volunteerId], references: [id])

  @@unique([volunteerId, projectId])
}

/// *
/// * =======================
/// * MENTORSHIP REQUEST
/// * =======================
model MentorshipRequest {
  id          String           @id @default(cuid())
  projectId   String
  mentorId    String
  volunteerId String?
  senderRole  MentorshipSender
  status      MentorshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  mentor      User             @relation("MentorRequests", fields: [mentorId], references: [id])
  project     Project          @relation(fields: [projectId], references: [id])
  volunteer   User?            @relation("VolunteerRequests", fields: [volunteerId], references: [id])

  @@unique([projectId, mentorId, volunteerId])
}

/// *
/// * =======================
/// * PROJECT CHAT
/// * =======================
model ProjectChat {
  id        String        @id @default(cuid())
  projectId String        @unique
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  project   Project       @relation(fields: [projectId], references: [id])
}

/// *
/// * =======================
/// * CHAT MESSAGE
/// * =======================
model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String?
  content   String?
  createdAt DateTime @default(now())
  isSystem  Boolean  @default(false)
  audioUrl  String?

  fileUrl  String?
  fileName String?
  fileType String?
  fileSize Int?

  chat   ProjectChat       @relation(fields: [chatId], references: [id])
  sender User?             @relation(fields: [senderId], references: [id])
  reads  ChatMessageRead[]
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model DirectConversation {
  id        String                 @id @default(cuid())
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  kind      DirectConversationKind @default(DIRECT)

  participants DirectConversationParticipant[]
  messages     DirectMessage[]
}

model DirectConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation("DirectConversationParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String?
  content        String?
  createdAt      DateTime @default(now())
  isSystem       Boolean  @default(false)
  audioUrl       String?

  fileUrl  String?
  fileName String?
  fileType String?
  fileSize Int?

  conversation DirectConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("DirectMessagesSent", fields: [senderId], references: [id])
  reads        DirectMessageRead[]
}

model DirectMessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation("DirectMessageReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

/// *
/// * =======================
/// * NOTIFICATION
/// * =======================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  link      String?
  type      NotificationType
  user      User             @relation(fields: [userId], references: [id])
}

/// *
/// * =======================
/// * REVIEW
/// * =======================

model Review {
  id String @id @default(cuid())

  volunteerId    String
  organizationId String
  projectId      String

  rating        Int
  overallRating Float?

  technicalSkill  Int?
  communication   Int?
  professionalism Int?
  timeliness      Int?

  strengths        String?
  improvementAreas String?

  comment   String
  createdAt DateTime @default(now())

  portfolioItem PortfolioItem?

  organization User    @relation("OrganizationReviews", fields: [organizationId], references: [id])
  project      Project @relation(fields: [projectId], references: [id])
  volunteer    User    @relation("VolunteerReviews", fields: [volunteerId], references: [id])
}

/// *
/// * =======================
/// * PORTFOLIO ITEM
/// * =======================
model PortfolioItem {
  id          String   @id @default(cuid())
  volunteerId String
  projectId   String
  reviewId    String?  @unique
  createdAt   DateTime @default(now())
  order       Int      @default(0)

  contribution String?
  proofUrl     String?
  imageUrl     String?
  project      Project @relation(fields: [projectId], references: [id])
  review       Review? @relation(fields: [reviewId], references: [id])
  volunteer    User    @relation(fields: [volunteerId], references: [id])
}

/// *
/// * =======================
/// * BADGE
/// * =======================

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  category    String?
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model SupportMessage {
  id       String  @id @default(cuid())
  ticketNo String? @unique

  name     String
  email    String
  subject  String
  category String?
  message  String
  status   String  @default("OPEN")
  priority String  @default("NORMAL")

  adminReply String?
  repliedAt  DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketNo])
  @@index([userId])
  @@index([projectId])
}

model ProjectSubmission {
  id          String @id @default(cuid())
  projectId   String
  volunteerId String

  message  String?
  workUrl  String? // GitHub / Live link
  fileUrl  String? // optional (Cloudinary etc)
  feedback String?

  status SubmissionStatus @default(PENDING)

  version Int @default(1) // 🔥 NEW

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  project   Project @relation(fields: [projectId], references: [id])
  volunteer User    @relation(fields: [volunteerId], references: [id])

  comments ProjectSubmissionComment[]
}

model ProjectSubmissionComment {
  id           String   @id @default(cuid())
  submissionId String
  userId       String
  message      String
  createdAt    DateTime @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
}

model ProjectFunding {
  id                String        @id @default(cuid())
  projectId         String        @unique
  organizationId    String
  volunteerId       String?
  stipendAmount     Int
  platformFee       Int
  volunteerAmount   Int
  status            FundingStatus @default(UNPAID)
  paystackReference String?       @unique
  paidAt            DateTime?
  releasedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  pending   Int      @default(0)
  withdrawn Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          String                  @id @default(cuid())
  userId      String
  projectId   String?
  type        WalletTransactionType
  amount      Int
  status      WalletTransactionStatus
  description String?
  createdAt   DateTime                @default(now())
}

model BankAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique
  bankName              String
  bankCode              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WithdrawalRequest {
  id     String           @id @default(cuid())
  userId String
  amount Int
  status WithdrawalStatus @default(PENDING)

  bankName              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String?

  walletTransactionId  String?
  paystackTransferCode String?
  failureReason        String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  code       String
  rewardPaid Boolean  @default(false)
  createdAt  DateTime @default(now())

  referrer User @relation("ReferrerReferrals", fields: [referrerId], references: [id])
  referred User @relation("ReferredUser", fields: [referredId], references: [id])
}

model Certificate {
  id            String @id @default(cuid())
  certificateNo String @unique

  volunteerId String
  issuedAt    DateTime @default(now())

  completedProjectsCount Int     @default(0)
  skillsSummary          String?

  volunteer User @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
}

model MentorReview {
  id String @id @default(cuid())

  mentorId    String
  volunteerId String
  projectId   String

  rating Int

  guidance        Int
  communication   Int
  availability    Int
  professionalism Int

  comment String

  createdAt DateTime @default(now())

  mentor User @relation("MentorReviewsReceived", fields: [mentorId], references: [id])

  volunteer User @relation("MentorReviewsGiven", fields: [volunteerId], references: [id])

  project Project @relation(fields: [projectId], references: [id])

  @@unique([mentorId, volunteerId, projectId])
}

model MentorAvailability {
  id        String   @id @default(cuid())
  mentorId  String
  dayOfWeek String
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
}

model MentorBooking {
  id          String  @id @default(cuid())
  mentorId    String
  volunteerId String
  projectId   String?

  date      DateTime
  startTime String
  endTime   String
  status    String   @default("PENDING")

  meetingLink String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor    User     @relation("MentorBookingsReceived", fields: [mentorId], references: [id])
  volunteer User     @relation("MentorBookingsMade", fields: [volunteerId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])

  @@index([mentorId])
  @@index([volunteerId])
  @@index([projectId])
}

model MentorCertification {
  id String @id @default(cuid())

  mentorId String
  mentor   User   @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  notes      String?
  reviewedBy String?
  reviewedAt DateTime?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorId])
  @@index([status])
}

model Opportunity {
  id String @id @default(cuid())

  organizationId String
  organization   User   @relation("OrganizationOpportunities", fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String

  type   OpportunityType
  status OpportunityStatus @default(PUBLISHED)

  workMode WorkMode?
  location String?

  compensation   String?
  applicationUrl String?
  contactEmail   String?

  imageUrl String?

  featured Boolean @default(false)

  featuredUntil DateTime?
  sponsoredTier String?
  sponsoredAt   DateTime?

  views Int @default(0)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads OpportunityLead[]

  sponsorships OpportunitySponsorship[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([featured])
}

model OpportunityLead {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("OpportunityLeads", fields: [userId], references: [id], onDelete: SetNull)

  name    String?
  email   String?
  phone   String?
  message String?

  source String @default("BUILDUP")

  createdAt DateTime @default(now())

  @@index([opportunityId])
  @@index([userId])
}

model OrganizationVerification {
  id String @id @default(cuid())

  organizationId String @unique
  organization   User   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  businessName       String
  registrationNumber String?
  websiteUrl         String?
  linkedinUrl        String?
  businessAddress    String?
  certificateUrl     String?

  status     String  @default("PENDING")
  adminNotes String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

model OpportunitySponsorship {
  id String @id @default(cuid())

  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  organizationId String

  tier   String
  amount Int
  days   Int

  status String @default("UNPAID") // UNPAID, PAID, FAILED, DISPUTED, EXPIRED

  paystackReference String @unique

  paidAt    DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId])
  @@index([organizationId])
  @@index([status])
}

model OpportunityAnalytics {
  id String @id @default(cuid())

  opportunityId String
  eventType     String // SPONSORED_VIEW, VIEW_DETAILS_CLICK, MARKETPLACE_CLICK

  source    String? // HOME_SPONSORED_SLIDER, MARKETPLACE_CARD, DETAILS_PAGE
  userId    String?
  sessionId String?

  createdAt DateTime @default(now())

  @@index([opportunityId])
  @@index([eventType])
  @@index([createdAt])
}

model CommunityPost {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category String
  content  String
  likes    Int     @default(0)
  isPinned Boolean @default(false)

  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments CommunityComment[]

  reactions CommunityReaction[]

  reports CommunityReport[]

  poll CommunityPoll?

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model CommunityComment {
  id String @id @default(cuid())

  postId String
  userId String

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model CommunityReaction {
  id String @id @default(cuid())

  postId String
  userId String

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  type String @default("LIKE")

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model CommunityReport {
  id String @id @default(cuid())

  postId String
  userId String

  reason String
  status String @default("PENDING")

  createdAt DateTime @default(now())

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  resolvedAt DateTime?
  resolvedBy String?

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([status])
}

model CommunityMessage {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())

  mediaUrl  String?
  mediaType String?

  @@index([createdAt])
}

model CommunityPoll {
  id     String        @id @default(cuid())
  postId String        @unique
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  question String
  options  CommunityPollOption[]

  createdAt DateTime @default(now())
}

model CommunityPollOption {
  id     String        @id @default(cuid())
  pollId String
  poll   CommunityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text  String
  votes CommunityPollVote[]

  createdAt DateTime @default(now())
}

model CommunityPollVote {
  id       String              @id @default(cuid())
  optionId String
  option   CommunityPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([optionId, userId])
}

model CommunityStory {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content   String?
  mediaUrl  String?
  mediaType String?

  expiresAt DateTime
  createdAt DateTime @default(now())

  views     CommunityStoryView[]
  reactions CommunityStoryReaction[]

  @@index([createdAt])
  @@index([expiresAt])
}

model CommunityStoryView {
  id String @id @default(cuid())

  storyId String
  story   CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model CommunityStoryReaction {
  id String @id @default(cuid())

  storyId String
  story   CommunityStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type String

  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model PlatformReview {
  id String @id @default(cuid())

  userId String

  easeOfUse           Int
  opportunities       Int
  communityExperience Int
  overallRating       Int

  review String?

  status PlatformReviewStatus @default(PENDING)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
