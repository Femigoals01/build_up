generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String        @id @default(cuid())
  name                       String
  email                      String        @unique
  password                   String
  role                       Role
  createdAt                  DateTime      @default(now())
  bio                        String?
  experience                 String?
  skills                     String?
  rating                     Float         @default(0)
  ratingCount                Int           @default(0)
  username                   String        @unique
  lastActivitySeenAt         DateTime      @default(now())
  mentorStatus               MentorStatus?
  country                    String?
  mobileNumber               String?
  countryCode                String?
  availabilityStatus         String?
  passwordResetToken         String?
  passwordResetExpiry        DateTime?
  careerGoal                 String?
  emailNotifications         Boolean       @default(true)
  githubUrl                  String?
  headline                   String?
  inAppNotifications         Boolean       @default(true)
  isPortfolioPublic          Boolean       @default(true)
  linkedinUrl                String?
  notifyBadges               Boolean       @default(true)
  notifyMentorMessages       Boolean       @default(true)
  notifyOrganizationMessages Boolean       @default(true)
  supportMessages            SupportMessage[]

  directConversationParticipants DirectConversationParticipant[] @relation("DirectConversationParticipants")
  directMessagesSent             DirectMessage[]                 @relation("DirectMessagesSent")
  directMessageReads             DirectMessageRead[]             @relation("DirectMessageReads")

  notifyProjectUpdates Boolean             @default(true)
  notifyReviews        Boolean             @default(true)
  notifyWeeklySummary  Boolean             @default(false)
  openToMentorGuidance Boolean             @default(true)
  portfolioWebsite     String?
  preferredDifficulty  String?
  showBadgesPublicly   Boolean             @default(true)
  showBioPublicly      Boolean             @default(true)
  showCountryPublicly  Boolean             @default(true)
  showEmailPublicly    Boolean             @default(false)
  showPhonePublicly    Boolean             @default(false)
  showReviewsPublicly  Boolean             @default(true)
  showSkillsPublicly   Boolean             @default(true)
  profileImageUrl      String?
  emailOtp             String?
  emailOtpExpiry       DateTime?
  emailVerified        Boolean             @default(false)
  applications         Application[]       @relation("VolunteerApplications")
  badges               Badge[]
  sentMessages         ChatMessage[]
  messageReads         ChatMessageRead[]
  mentorRequests       MentorshipRequest[] @relation("MentorRequests")
  volunteerRequests    MentorshipRequest[] @relation("VolunteerRequests")
  notifications        Notification[]
  portfolio            PortfolioItem[]
  mentoredProjects     Project[]           @relation("MentorProjects")
  projects             Project[]           @relation("OrganizationProjects")
  reviewsGiven         Review[]            @relation("OrganizationReviews")
  reviewsReceived      Review[]            @relation("VolunteerReviews")
}

/// *
/// * =======================
/// * PROJECT
/// * =======================
model Project {
  id                 String              @id @default(cuid())
  title              String
  description        String
  requirements       String?
  status             ProjectStatus       @default(OPEN)
  createdAt          DateTime            @default(now())
  organizationId     String
  difficulty         Difficulty
  skills             String[]
  mentorId           String?
  applications       Application[]
  mentorshipRequests MentorshipRequest[]
  portfolioItems     PortfolioItem[]
  mentor             User?               @relation("MentorProjects", fields: [mentorId], references: [id])
  organization       User                @relation("OrganizationProjects", fields: [organizationId], references: [id])
  chat               ProjectChat?
  reviews            Review[]
}

/// *
/// * =======================
/// * APPLICATION
/// * =======================
model Application {
  id          String            @id @default(cuid())
  status      ApplicationStatus @default(PENDING)
  source      ApplicationSource @default(VOLUNTEER)
  createdAt   DateTime          @default(now())
  volunteerId String
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id])
  volunteer   User              @relation("VolunteerApplications", fields: [volunteerId], references: [id])

  @@unique([volunteerId, projectId])
}

/// *
/// * =======================
/// * MENTORSHIP REQUEST
/// * =======================
model MentorshipRequest {
  id          String           @id @default(cuid())
  projectId   String
  mentorId    String
  volunteerId String?
  senderRole  MentorshipSender
  status      MentorshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  mentor      User             @relation("MentorRequests", fields: [mentorId], references: [id])
  project     Project          @relation(fields: [projectId], references: [id])
  volunteer   User?            @relation("VolunteerRequests", fields: [volunteerId], references: [id])

  @@unique([projectId, mentorId, volunteerId])
}

/// *
/// * =======================
/// * PROJECT CHAT
/// * =======================
model ProjectChat {
  id        String        @id @default(cuid())
  projectId String        @unique
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  project   Project       @relation(fields: [projectId], references: [id])
}

/// *
/// * =======================
/// * CHAT MESSAGE
/// * =======================
model ChatMessage {
  id        String            @id @default(cuid())
  chatId    String
  senderId  String?
  content   String?
  createdAt DateTime          @default(now())
  isSystem  Boolean           @default(false)
  audioUrl  String?
  chat      ProjectChat       @relation(fields: [chatId], references: [id])
  sender    User?             @relation(fields: [senderId], references: [id])
  reads     ChatMessageRead[]
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
}

model DirectConversation {
  id        String                 @id @default(cuid())
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  kind      DirectConversationKind @default(DIRECT)

  participants DirectConversationParticipant[]
  messages     DirectMessage[]
}

model DirectConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation("DirectConversationParticipants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model DirectMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String?
  content        String?
  createdAt      DateTime @default(now())
  isSystem       Boolean  @default(false)
  audioUrl       String?

  conversation DirectConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?               @relation("DirectMessagesSent", fields: [senderId], references: [id])
  reads        DirectMessageRead[]
}

model DirectMessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation("DirectMessageReads", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

/// *
/// * =======================
/// * NOTIFICATION
/// * =======================
model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  link      String?
  type      NotificationType
  user      User             @relation(fields: [userId], references: [id])
}

/// *
/// * =======================
/// * REVIEW
/// * =======================
model Review {
  id             String         @id @default(cuid())
  volunteerId    String
  organizationId String
  projectId      String
  rating         Int
  comment        String
  createdAt      DateTime       @default(now())
  portfolioItem  PortfolioItem?
  organization   User           @relation("OrganizationReviews", fields: [organizationId], references: [id])
  project        Project        @relation(fields: [projectId], references: [id])
  volunteer      User           @relation("VolunteerReviews", fields: [volunteerId], references: [id])
}

/// *
/// * =======================
/// * PORTFOLIO ITEM
/// * =======================
model PortfolioItem {
  id           String   @id @default(cuid())
  volunteerId  String
  projectId    String
  reviewId     String?  @unique
  createdAt    DateTime @default(now())
  order        Int      @default(0)
  contribution String?
  proofUrl     String?
  imageUrl     String?
  project      Project  @relation(fields: [projectId], references: [id])
  review       Review?  @relation(fields: [reviewId], references: [id])
  volunteer    User     @relation(fields: [volunteerId], references: [id])
}

/// *
/// * =======================
/// * BADGE
/// * =======================
model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}



model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  category  String?
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

/// *
/// * =======================
/// * ENUMS
/// * =======================
enum Role {
  VOLUNTEER
  ORGANIZATION
  MENTOR
  ADMIN
}

enum MentorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorshipSender {
  VOLUNTEER
  MENTOR
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NotificationType {
  APPLICATION
  PROJECT
  REVIEW
  BADGE
  SYSTEM
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ApplicationSource {
  VOLUNTEER
  ORGANIZATION
}

enum DirectConversationKind {
  DIRECT
}
